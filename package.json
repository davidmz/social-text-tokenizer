{
  "name": "social-text-tokenizer",
  "version": "3.2.2",
  "description": "Posts/comments text parser for FreeFeed.net",
  "homepage": "https://github.com/davidmz/social-text-tokenizer",
  "author": "David Mzareulyan <david@hiero.ru> (https://github.com/davidmz)",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "test": "vitest --run",
    "test-watch": "vitest",
    "build": "run-s check build:unbuild",
    "check": "run-p check:tsc check:lint test",
    "build:unbuild": "ts-lib-build",
    "check:tsc": "tsc",
    "check:lint": "eslint src --ext .js,.ts,.mjs",
    "prepublish": "run-s build",
    "prepublishOnly": "ts-lib-build check-publish"
  },
  "devDependencies": {
    "@davidmz/ts-lib-build": "^0.5.0",
    "@eslint/js": "^9.30.1",
    "@types/lodash.escaperegexp": "^4.1.9",
    "@types/node": "^25.6.0",
    "@types/punycode": "~2.1.4",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "npm-run-all": "~4.1.5",
    "prettier": "3.8.2",
    "ts-node": "^10.9.2",
    "type-fest": "^4.41.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "lodash.escaperegexp": "^4.1.2",
    "punycode.js": "^2.3.1",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "directory": "build"
  }
